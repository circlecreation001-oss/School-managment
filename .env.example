# ===================================
# Application
# ===================================
NODE_ENV=production
APP_NAME=SchoolNex
APP_URL=https://schoolnex.in
API_URL=https://your-backend.onrender.com
API_PORT=4000
API_PREFIX=/api/v1

# ===================================
# Database (Supabase PostgreSQL)
# ===================================
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ===================================
# Redis (Upstash)
# ===================================
REDIS_URL=rediss://default:[PASSWORD]@[HOST]:6379

# ===================================
# JWT Authentication
# ===================================
JWT_ACCESS_SECRET=generate-a-64-char-random-string
JWT_REFRESH_SECRET=generate-another-64-char-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===================================
# Platform Super Admin (auto-created on startup)
# ===================================
SUPER_ADMIN_EMAIL=shivam95ku@gmail.com
SUPER_ADMIN_PASSWORD=Circle@123
SUPER_ADMIN_FIRST_NAME=Shivam
SUPER_ADMIN_LAST_NAME=Kumar
SUPER_ADMIN_PHONE=+919572495969

# ===================================
# Encryption
# ===================================
ENCRYPTION_KEY=generate-a-32-char-random-string

# ===================================
# Storage (Supabase Storage)
# ===================================
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://[PROJECT-REF].supabase.co/storage/v1/s3
S3_ACCESS_KEY=[SUPABASE-SERVICE-KEY]
S3_SECRET_KEY=[SUPABASE-SERVICE-KEY]
S3_BUCKET=schoolnex
S3_REGION=us-east-1

# ===================================
# Email (SMTP - Resend)
# ===================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=[RESEND-API-KEY]
SMTP_FROM_NAME=SchoolNex
SMTP_FROM_EMAIL=noreply@schoolnex.in

# ===================================
# SMS
# ===================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
MSG91_API_KEY=

# ===================================
# WhatsApp (Meta Cloud API)
# ===================================
WHATSAPP_PROVIDER=meta
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ===================================
# Payment Gateway (Razorpay)
# ===================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ===================================
# Logging
# ===================================
LOG_LEVEL=info
LOG_FORMAT=json

# ===================================
# Rate Limiting
# ===================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===================================
# CORS
# ===================================
CORS_ORIGINS=https://schoolnex.in,https://www.schoolnex.in

# ===================================
# Frontend (Vercel)
# ===================================
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api/v1
NEXT_PUBLIC_APP_URL=https://schoolnex.in
