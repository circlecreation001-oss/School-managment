# ===================================
# Application
# ===================================
NODE_ENV=production
APP_NAME=SchoolNex
APP_URL=https://your-frontend-domain.com
API_URL=https://your-backend-domain.com
API_PORT=4000
API_PREFIX=/api/v1

# ===================================
# Database (PostgreSQL)
# ===================================
DATABASE_URL=<YOUR_DATABASE_URL>
DIRECT_URL=<YOUR_DIRECT_DATABASE_URL>

# ===================================
# Redis
# ===================================
REDIS_URL=<YOUR_REDIS_URL>

# ===================================
# JWT Authentication
# ===================================
JWT_ACCESS_SECRET=<GENERATE_RANDOM_64_CHAR_SECRET>
JWT_REFRESH_SECRET=<GENERATE_RANDOM_64_CHAR_SECRET>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===================================
# Platform Super Admin (auto-created on startup)
# ===================================
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=<CHANGE_ME>
SUPER_ADMIN_FIRST_NAME=Admin
SUPER_ADMIN_LAST_NAME=User
SUPER_ADMIN_PHONE=+910000000000

# ===================================
# Encryption
# ===================================
ENCRYPTION_KEY=<GENERATE_RANDOM_32_CHAR_KEY>

# ===================================
# Storage (S3-compatible)
# ===================================
STORAGE_PROVIDER=s3
S3_ENDPOINT=<YOUR_S3_ENDPOINT>
S3_ACCESS_KEY=<YOUR_S3_ACCESS_KEY>
S3_SECRET_KEY=<YOUR_S3_SECRET_KEY>
S3_BUCKET=schoolnex
S3_REGION=us-east-1

# ===================================
# Email (SMTP)
# ===================================
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=<SMTP_USERNAME>
SMTP_PASS=<SMTP_PASSWORD_OR_API_KEY>
SMTP_FROM_NAME=SchoolNex
SMTP_FROM_EMAIL=noreply@your-domain.com

# ===================================
# SMS (Optional)
# ===================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=<TWILIO_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<TWILIO_AUTH_TOKEN>
MSG91_API_KEY=<MSG91_API_KEY>

# ===================================
# WhatsApp (Optional)
# ===================================
WHATSAPP_PROVIDER=meta
WHATSAPP_API_KEY=<META_WHATSAPP_API_KEY>
WHATSAPP_PHONE_NUMBER_ID=<PHONE_NUMBER_ID>

# ===================================
# Payment Gateway (Optional)
# ===================================
RAZORPAY_KEY_ID=<RAZORPAY_KEY_ID>
RAZORPAY_KEY_SECRET=<RAZORPAY_KEY_SECRET>
RAZORPAY_WEBHOOK_SECRET=<RAZORPAY_WEBHOOK_SECRET>

# ===================================
# Logging
# ===================================
LOG_LEVEL=info
LOG_FORMAT=json

# ===================================
# Rate Limiting
# ===================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===================================
# CORS (comma-separated origins)
# ===================================
CORS_ORIGINS=https://your-frontend-domain.com

# ===================================
# Frontend
# ===================================
NEXT_PUBLIC_API_URL=https://your-backend-domain.com/api/v1
NEXT_PUBLIC_APP_URL=https://your-frontend-domain.com
